 "dtype": "uint8",
 "codes": {
  "0": {
   "name": "ABSENT",
   "meaning": "No native source cell maps to this pixel and no value was supplied. The layer value is NaN.",
   "value_is": "NaN",
   "support_is": "NaN"
  },
  "1": {
   "name": "BINNED",
   "meaning": "The value is an area-weighted mean of the native cells falling in this pixel. Support is the cos(lat)-weighted fraction of those cells that carried a usable value.",
   "value_is": "finite",
   "support_is": "greater than 0"
  },
  "2": {
   "name": "COPIED_FROM_COARSER",
   "meaning": "No native cell fell in this pixel, so the value was COPIED from the nearest source cell. The value is usable but it is shared with neighbouring pixels, so it adds no independent information. Filter on distinct_levels and largest_tie_fraction, not on support.",
   "value_is": "finite",
   "support_is": "exactly 0.0"
  },
  "3": {
   "name": "NO_VALID_SOURCE",
   "meaning": "The source grid COVERS this pixel but supplied no usable value. Two distinct situations share this code and the stored arrays cannot separate them: (a) the product reports nodata here BY DESIGN -- MOD11C3 is land-only, so 8.5 million ocean pixels are code 3 on every Earth thermal layer; and (b) every contributing cell FAILED a quality test, as with the 803 flat-water pixels that failed the R-squared gate on scaling_exponent_r2. Check the layer's own coverage note before reading code 3 as failure. The value is NaN either way. It is still NOT the same as ABSENT, where no source cell reaches the pixel at all.",
   "value_is": "NaN",
   "support_is": "exactly 0.0"
  }
 },
 "why_this_exists": "support == 0.0 previously meant NO_VALID_SOURCE on the scaling-exponent layers and COPIED_FROM_COARSER on the phase 3 thermal layers. Downstream code testing `support > 0` for usability would have silently dropped every copied thermal pixel, which is 99.91% of Mars and 71.12% of the Moon. Never infer usability from support alone; read this code.",
 "usable_for_statistics": [
  1,
  2
 ],
 "missing": [
  0,
  3
 ],
